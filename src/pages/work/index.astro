---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order
);

const seo = {
	title: 'Selected Work — CILO MEDIA STUDIO',
	description: 'A look at the brands we have helped build, create, and grow.',
};
---

<SiteLayout seo={seo}>
	<section class="section--dark page-hero">
		<div class="container">
			<p class="page-hero__eyebrow">Selected Work</p>
			<h1 class="page-hero__title">Work that earns its keep.</h1>
			<p class="page-hero__intro">
				A look at the brands we've helped build, create, and grow.
			</p>
		</div>
	</section>

	<div class="work-index">
		{
			projects.map((p) => (
				<a class="work-index__item" href={`/work/${p.slug}`}>
					<div
						class="work-index__media media-ph"
						style={`background-image:url('/assets/images/cilo/work/${p.slug}.jpg')`}
					/>
					<div class="work-index__meta">
						<h2 class="work-index__name">
							{p.data.title} <span class="muted">— {p.data.category}</span>
						</h2>
						<p class="work-index__summary">{p.data.summary}</p>
						<span class="arrow">View project <span aria-hidden="true">→</span></span>
					</div>
				</a>
			))
		}
	</div>
</SiteLayout>

<style>
	.work-index__item {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: 86vh;
		color: #fff;
		text-decoration: none;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}
	.work-index__media {
		position: absolute;
		inset: 0;
	}
	.work-index__media::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.72));
		transition: background var(--theme-transition);
	}
	.work-index__item:hover .work-index__media::before {
		background: linear-gradient(
			180deg,
			color-mix(in oklab, var(--theme-primary) 25%, transparent),
			color-mix(in oklab, var(--theme-primary) 80%, black)
		);
	}
	.work-index__meta {
		position: relative;
		padding: clamp(1.5rem, 4vw, 3rem);
		max-width: 46ch;
	}
	.work-index__name {
		font-family: var(--theme-font-family-serif);
		font-weight: 500;
		font-size: clamp(2rem, 3.5vw, 3rem);
		margin: 0 0 0.75rem;
	}
	.work-index__name .muted {
		color: rgba(255, 255, 255, 0.7);
	}
	.work-index__summary {
		margin: 0 0 1.25rem;
		color: rgba(255, 255, 255, 0.85);
	}
</style>
