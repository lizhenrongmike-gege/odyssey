---
import settings from '../../config/settings.js';
const { business } = settings;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<span class="site-footer__brand">CILO MEDIA STUDIO</span>
		<nav class="site-footer__links" aria-label="Footer">
			<!-- TODO: real Instagram + LinkedIn URLs -->
			<a href="#">Instagram</a>
			<a href="#">LinkedIn</a>
			<a href={`mailto:${business.email}`}>Email</a>
		</nav>
		<span class="site-footer__loc">Burlingame, California</span>
		<span class="site-footer__copy">© {year} CILO MEDIA STUDIO LLC. All rights reserved.</span>
	</div>
</footer>

<style>
	.site-footer {
		padding: clamp(2.5rem, 6vw, 4rem) 0;
		border-top: 1px solid var(--theme-on-bg);
	}
	.site-footer__grid {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
	}
	.site-footer__brand {
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: -0.02em;
	}
	.site-footer__links {
		display: flex;
		gap: 1.5rem;
	}
	.site-footer__links a {
		color: var(--theme-on-bg);
		text-decoration: none;
		transition: color var(--theme-transition);
	}
	.site-footer__links a:hover {
		color: var(--theme-primary);
	}
	.site-footer__loc,
	.site-footer__copy {
		font-size: 0.85rem;
		color: color-mix(in oklab, var(--theme-on-bg) 60%, transparent);
	}
</style>
